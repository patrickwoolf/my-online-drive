<div># 1. 載入必要套件 (若未安裝請執行 install.packages(c("meta", "dplyr", "readr")))</div><div>library(meta)</div><div>library(dplyr)</div><div>library(readr)</div><div><br></div><div># ==========================================</div><div># 2. 修改區：在此調整您的篩選條件</div><div># ==========================================</div><div>FILE_PATH &lt;- "CPB data.xlsx" &nbsp;# 您的檔案路徑</div><div>TARGET_MEASUREMENT &lt;- "VAS rest" &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; # 欲分析的指標 (例如 "VAS rest", "Opioid consumption")</div><div>TARGET_TIMEPOINT &lt;- "24 Hours" &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; # 欲分析的時間點 (輸入 "all" 或特定字串如 "24 Hours")</div><div>EXP_GROUP &lt;- "Superficial CPB" &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; # 實驗組名稱 (對應 Treatment1 或 Treatment2)</div><div>CTRL_GROUP &lt;- "General Anesthesia" &nbsp; &nbsp; &nbsp; &nbsp; # 對照組名稱</div><div><br></div><div># ==========================================</div><div># 3. 讀取與資料清洗</div><div># ==========================================</div><div>raw_data &lt;- read_csv(FILE_PATH)</div><div><br></div><div># 資料篩選</div><div>analysis_data &lt;- raw_data %&gt;%</div><div>&nbsp; filter(Measurement == TARGET_MEASUREMENT) %&gt;%</div><div>&nbsp; filter(if(TARGET_TIMEPOINT == "all") TRUE else Timepoint == TARGET_TIMEPOINT)</div><div><br></div><div># 轉換功能：將 Median/IQR 或 p-value 轉為 Mean/SD</div><div># 這裡採用 Wan et al. (2014) 與 Cochrane 建議之簡化公式</div><div>clean_data &lt;- analysis_data %&gt;%</div><div>&nbsp; mutate(</div><div>&nbsp; &nbsp; # 處理第一組 (Data1)</div><div>&nbsp; &nbsp; final_mean1 = ifelse(!is.na(Mean1), Mean1, Data1), # 有 Mean 用 Mean，否則用 Median</div><div>&nbsp; &nbsp; final_sd1 = case_when(</div><div>&nbsp; &nbsp; &nbsp; !is.na(SD1) ~ SD1,</div><div>&nbsp; &nbsp; &nbsp; Data == "Median, IQR" ~ as.numeric(sub(".*–", "", Error1)) - as.numeric(sub("–.*", "", Error1)) / 1.35,</div><div>&nbsp; &nbsp; &nbsp; TRUE ~ NA_real_</div><div>&nbsp; &nbsp; ),</div><div>&nbsp; &nbsp; # 處理第二組 (Data2)</div><div>&nbsp; &nbsp; final_mean2 = ifelse(!is.na(Mean2), Mean2, Data2),</div><div>&nbsp; &nbsp; final_sd2 = case_when(</div><div>&nbsp; &nbsp; &nbsp; !is.na(SD2) ~ SD2,</div><div>&nbsp; &nbsp; &nbsp; Data == "Median, IQR" ~ as.numeric(sub(".*–", "", Error2)) - as.numeric(sub("–.*", "", Error2)) / 1.35,</div><div>&nbsp; &nbsp; &nbsp; TRUE ~ NA_real_</div><div>&nbsp; &nbsp; )</div><div>&nbsp; ) %&gt;%</div><div>&nbsp; filter(!is.na(final_sd1) &amp; !is.na(final_sd2)) # 排除無法計算 SD 的研究</div><div><br></div><div># ==========================================</div><div># 4. 執行 Meta-analysis (SMD 模型)</div><div># ==========================================</div><div># 因為 VAS 與不同指標單位可能不同，建議使用 SMD (Standardized Mean Difference)</div><div>m_result &lt;- metacont(</div><div>&nbsp; n.e = N1, mean.e = final_mean1, sd.e = final_sd1,</div><div>&nbsp; n.c = N2, mean.c = final_mean2, sd.c = final_sd2,</div><div>&nbsp; data = clean_data,</div><div>&nbsp; studlab = Study,</div><div>&nbsp; sm = "SMD", &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;# 使用 SMD</div><div>&nbsp; method.tau = "REML", &nbsp; # 隨機效應模型建議使用 REML</div><div>&nbsp; prediction = TRUE &nbsp; &nbsp; &nbsp;# 顯示預測區間</div><div>)</div><div><br></div><div># ==========================================</div><div># 5. 輸出圖表</div><div># ==========================================</div><div><br></div><div># A. Forest Plot (森林圖)</div><div># 設定檔名與圖片大小</div><div>png("Forest_Plot.png", width = 1000, height = 600, res = 120)</div><div>forest(m_result,&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp;leftcols = c("studlab", "n.e", "n.c"),</div><div>&nbsp; &nbsp; &nbsp; &nbsp;rightcols = c("effect", "ci", "w.random"),</div><div>&nbsp; &nbsp; &nbsp; &nbsp;smd.label = "Standardized Mean Difference",</div><div>&nbsp; &nbsp; &nbsp; &nbsp;print.tau2 = TRUE,</div><div>&nbsp; &nbsp; &nbsp; &nbsp;col.predict = "blue")</div><div>dev.off()</div><div><br></div><div># B. Funnel Plot (漏斗圖)</div><div>png("Funnel_Plot.png", width = 800, height = 600, res = 120)</div><div>funnel(m_result,&nbsp;</div><div>&nbsp; &nbsp; &nbsp; &nbsp;xlab = "Standardized Mean Difference",</div><div>&nbsp; &nbsp; &nbsp; &nbsp;studlab = TRUE)</div><div>dev.off()</div><div><br></div><div># C. 顯示文字統計結果</div><div>summary(m_result)</div><div></div>