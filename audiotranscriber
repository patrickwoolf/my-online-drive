  <!DOCTYPE html>
  <html lang="zh-Hant"><head><meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>本地轉錄</title>
  <style>
  body{font:16px system-ui;max-width:600px;margin:auto;padding:16px}
  select,button,input{width:100%;padding:12px;margin:6px 0;font-size:16px;box-sizing:border-box}
  textarea{width:100%;height:50vh;font-size:15px;box-sizing:border-box}
  </style></head><body>
  <h3>🎙 本地音訊轉錄</h3>
  <input type="file" id="f" accept=".mp3,.m4a,audio/*">
  <select id="m">
   <option value="Xenova/whisper-tiny">tiny(最快、較不準)</option>
   <option value="Xenova/whisper-base" selected>base(推薦)</option>
   <option value="Xenova/whisper-small">small(最準、較慢)</option>
  </select>
  <select id="l">
   <option value="">自動偵測語言</option>
   <option value="chinese">中文</option>
   <option value="english">English</option>
   <option value="japanese">日本語</option>
   <option value="korean">한국어</option>
  </select>
  <button id="go">開始轉錄</button>
  <div id="s">就緒</div>
  <textarea id="o" placeholder="結果顯示於此"></textarea>
  <button id="cp">複製</button>
  <button id="dl">下載 txt</button>
  <script type="module">
  import{pipeline}from"https://cdn.jsdelivr.net/npm/@huggingface/transformers@3";
  const $=i=>document.getElementById(i);
  $("go").onclick=async()=>{
   const file=$("f").files[0];if(!file)return $("s").textContent="請先選擇檔案";
   try{
    $("go").disabled=true;$("s").textContent="載入模型中…(首次需下載)";
    const asr=await pipeline("automatic-speech-recognition",$("m").value,{
     device:navigator.gpu?"webgpu":"wasm",
     progress_callback:p=>{if(p.status=="progress")$("s").textContent=`下載 ${p.file} ${p.progress|0}%`}
    });
    $("s").textContent="解碼音訊…";
    const ctx=new AudioContext({sampleRate:16000});
    const buf=await ctx.decodeAudioData(await file.arrayBuffer());
    const a=buf.getChannelData(0);
    $("s").textContent="轉錄中…請保持畫面開啟";$("o").value="";
    const r=await asr(a,{
     chunk_length_s:30,stride_length_s:5,return_timestamps:true,
     language:$("l").value||null,task:"transcribe"
    });
    $("o").value=r.chunks.map(c=>`[${(c.timestamp[0]|0)}s] ${c.text.trim()}`).join("\n");
    $("s").textContent="完成 ✅";
   }catch(e){$("s").textContent="錯誤:"+e.message}
   $("go").disabled=false;
  };
  $("cp").onclick=()=>navigator.clipboard.writeText($("o").value);
  $("dl").onclick=()=>{const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([$("o").value]));a.download="transcript.txt";a.click()};
  </script></body></html>
