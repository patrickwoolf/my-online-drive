<div><font color="#0f172a">確認以下幾點:</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">1. Pain, ER 用 MD; Func 用 SMD</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">2. Steroid + Saline, 有空格OK</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">3. 初始可以設定intervention欄位: e.g. Final.Node.4，若欄位內無數據或字串，則跳過該study arm。</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">4. 要有league table、SUCRA、Netplot、Forest plot (NMA , cNMA)、netheat</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">5. cNMA 中空格不會被保留在成分名稱中（變成 "Steroid " 與 " Saline"），加入 trimws() 函數自動去除頭尾空格</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">library(gemtc)</font></div><div><font color="#0f172a">library(netmeta)</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a"># ==========================================</font></div><div><font color="#0f172a"># 1. 初始設定區</font></div><div><font color="#0f172a"># ==========================================</font></div><div><font color="#0f172a">raw_df &lt;- read.csv("my_data.csv", stringsAsFactors = FALSE)</font></div><div><font color="#0f172a">target_outcomes &lt;- c("Pain", "ER", "Func")</font></div><div><font color="#0f172a">target_timepoints &lt;- c("ES", "mid", "LS")</font></div><div><font color="#0f172a">intervention_col &lt;- "Final.Node.4"&nbsp; # 指定分析的欄位</font></div><div><font color="#0f172a">rho &lt;- 0.5&nbsp;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">for (out in target_outcomes) {</font></div><div><font color="#0f172a">&nbsp; for (tp in target_timepoints) {</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- A. 數據清洗與欄位檢查 ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; # 剔除指定欄位為空值或空字串的資料</font></div><div><font color="#0f172a">&nbsp; &nbsp; valid_data &lt;- raw_df[!is.na(raw_df[[intervention_col]]) &amp; raw_df[[intervention_col]] != "", ]</font></div><div><font color="#0f172a">&nbsp; &nbsp; sub_data &lt;- valid_data[valid_data$outcome == out &amp; valid_data$timepoint == tp, ]</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; if (nrow(sub_data) &lt; 2) next&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; cat("\n&gt;&gt;&gt; 分析中:", out, "|", tp, "| 使用欄位:", intervention_col, "&lt;&lt;&lt;\n")</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- B. 方向性與進步量計算 ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; if (out == "Pain") {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; sub_data$mean_change &lt;- sub_data$m_pre - sub_data$m_post</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; current_sm &lt;- "MD"&nbsp; # Pain 使用 MD</font></div><div><font color="#0f172a">&nbsp; &nbsp; } else if (out == "ER") {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; sub_data$mean_change &lt;- sub_data$m_post - sub_data$m_pre</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; current_sm &lt;- "MD"&nbsp; # ER 使用 MD</font></div><div><font color="#0f172a">&nbsp; &nbsp; } else if (out == "Func") {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; sub_data$mean_change &lt;- (sub_data$m_post - sub_data$m_pre) * sub_data$scale_direction</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; current_sm &lt;- "SMD" # Func 使用 SMD</font></div><div><font color="#0f172a">&nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; sub_data$sd_change &lt;- sqrt(sub_data$sd_pre^2 + sub_data$sd_post^2 -&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;2 * rho * sub_data$sd_pre * sub_data$sd_post)</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; # 統一欄位名稱給套件使用</font></div><div><font color="#0f172a">&nbsp; &nbsp; mydata &lt;- data.frame(</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; study = sub_data$study,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; treatment = trimws(sub_data[[intervention_col]]), # 去除 Steroid + Saline 的多餘空格</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; mean = sub_data$mean_change,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; std.dev = sub_data$sd_change,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; sampleSize = sub_data$n</font></div><div><font color="#0f172a">&nbsp; &nbsp; )</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- C. Frequentist NMA (產出 Q, I2, Forest) ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; nma_net &lt;- tryCatch({</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; netcont(mean, std.dev, sampleSize, study, treatment,&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; data = mydata, sm = current_sm, random = TRUE)</font></div><div><font color="#0f172a">&nbsp; &nbsp; }, error = function(e) { return(NULL) })</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; if (is.null(nma_net)) next</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # 繪製 Forest Plot (顯示異質性 Q, I2, tau2)</font></div><div><font color="#0f172a">&nbsp; &nbsp; forest(nma_net, prediction = TRUE, pooled = "random",&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;smlab = paste(current_sm, "Improvement:", out),</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;main = paste(out, tp))</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # Netheat Plot</font></div><div><font color="#0f172a">&nbsp; &nbsp; netheat(nma_net)</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- D. Bayesian NMA (產出 SUCRA, Node-splitting) ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; # gemtc 需處理 arm-level data</font></div><div><font color="#0f172a">&nbsp; &nbsp; network &lt;- mtc.network(data.re = mydata)</font></div><div><font color="#0f172a">&nbsp; &nbsp; model &lt;- mtc.model(network, likelihood="normal", link="identity", linearModel="random")</font></div><div><font color="#0f172a">&nbsp; &nbsp; results &lt;- mtc.run(model, n.adapt=5000, n.iter=20000)</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # SUCRA 排名</font></div><div><font color="#0f172a">&nbsp; &nbsp; ranks &lt;- mtc.rank.probability(results, lowerInterval=FALSE)</font></div><div><font color="#0f172a">&nbsp; &nbsp; print(rank.probability.auc(ranks))</font></div><div><font color="#0f172a">&nbsp; &nbsp; plot(ranks, beside=TRUE, main=paste("SUCRA:", out, tp))</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # SIDE test</font></div><div><font color="#0f172a">&nbsp; &nbsp; node_split &lt;- mtc.nodesplit(network, n.adapt=5000, n.iter=20000)</font></div><div><font color="#0f172a">&nbsp; &nbsp; plot(summary(node_split))</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- E. Component NMA (處理 Steroid + Saline) ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; if (any(grepl("\\+", mydata$treatment))) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; try({</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; # sep = "+" 會自動處理組分拆解</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; cnma &lt;- netcomplex(nma_net)&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; forest(cnma, main = paste("Component:", out, tp))</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; })</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; # --- F. League Table (產出所有兩兩比較) ---</font></div><div><font color="#0f172a">&nbsp; &nbsp; # 建立 League Table 物件</font></div><div><font color="#0f172a">&nbsp; &nbsp; league &lt;- netleague(nma_net,&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; bracket = "(",&nbsp; &nbsp; # 區間符號</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; digits = 2,&nbsp; &nbsp; &nbsp; &nbsp;# 小數點位數</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; separator = " to ") # 區間分隔字</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; # 印在 R Console 畫面上查看</font></div><div><font color="#0f172a">&nbsp; &nbsp; cat("\nLeague Table for", out, tp, ":\n")</font></div><div><font color="#0f172a">&nbsp; &nbsp; print(league$random) # 顯示隨機效應模型的結果</font></div><div><font color="#0f172a">&nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; # 自動匯出成 CSV (檔名會根據 Outcome 和 Timepoint 自動命名)</font></div><div><font color="#0f172a">&nbsp; &nbsp; write.csv(league$random,&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; file = paste0("LeagueTable_", out, "_", tp, ".csv"),&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; row.names = TRUE)</font></div><div><font color="#0f172a">&nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; }</font></div><div><font color="#0f172a">}</font></div><div><br></div><div></div>