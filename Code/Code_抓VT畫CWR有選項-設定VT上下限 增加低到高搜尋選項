t color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="number" id="vt1-max-input" value="200" min="1"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;VT2 搜尋下限 (W)&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="number" id="vt2-min-input" value="100" min="0"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;VT2 搜尋上限 (W)&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="number" id="vt2-max-input" value="240" min="1"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="config-row"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;VT1 通氣閾值首選求法&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;select id="vt1-method-select"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="v_slope" selected&gt;V-Slope 局部滑動迴歸法 (斜率轉折)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="regression"&gt;VE/VO₂ 二次迴歸擬合 (最平滑預估)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="abs_min"&gt;VE/VO₂ 絕對最低點法 (單點觸底)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/select&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="config-row"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;VT2 呼吸代償點首選求法&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;select id="vt2-method-select"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="regression" selected&gt;VE/VCO₂ 二次迴歸擬合 (迴歸最低點)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="forward_scan"&gt;正向低端爬升轉折法 (Low-to-High 爬升起點)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="reverse_scan"&gt;逆向高端平台起漲法 (High-to-Low 基準參考)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;option value="abs_min"&gt;VE/VCO₂ 絕對最低點法 (區間全域最低)&lt;/option&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/select&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;button class="btn-parse" onclick="processDataAndRenderChart(true)"&gt;⚡ 執行生理學自動判讀&lt;/button&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="tuning-panel"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="tuning-title"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;🎨 專家視覺判讀微調面版&lt;/span&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span style="font-size: 11px; font-weight: normal; color: #666;"&gt;(拉動即時變更圖表)&lt;/span&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slider-row"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;調整 VT1 閾值功率: &lt;span id="vt1-val-display" style="color:#d35400;"&gt;-- W&lt;/span&gt;&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="range" id="vt1-slider" min="0" max="250" value="80" oninput="onSliderChange()"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="slider-row vt2"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;調整 VT2 閾值功率: &lt;span id="vt2-val-display" style="color:#8e44ad;"&gt;-- W&lt;/span&gt;&lt;/label&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="range" id="vt2-slider" min="0" max="250" value="130" oninput="onSliderChange()"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div id="debug-log" class="debug-status"&gt;系統就緒...&lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="panel-chart"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="chart-container"&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;canvas id="fitnessChart"&gt;&lt;/canvas&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &lt;/div&gt;</font></div><div><font color="#0f172a">&lt;/div&gt;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&lt;script&gt;</font></div><div><font color="#0f172a">&nbsp; &nbsp; window.onload = function() {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; processDataAndRenderChart(true);</font></div><div><font color="#0f172a">&nbsp; &nbsp; };</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; let myChart = null;</font></div><div><font color="#0f172a">&nbsp; &nbsp; let globalTestData = [];</font></div><div><font color="#0f172a">&nbsp; &nbsp; let globalCwrPoints = [];</font></div><div><font color="#0f172a">&nbsp; &nbsp; let lastDetectionLogs = [];</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; // 解析文字表頭（防止特徵碰撞）並排除 WR = 0 的資料</font></div><div><font color="#0f172a">&nbsp; &nbsp; function parseAdvancedText(text) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const lines = text.trim().split('\n');</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; if (lines.length &lt; 2) return [];</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let headerRow = lines[0].trim().split(/\s+/);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vevo2Idx = headerRow.findIndex(h =&gt; h.includes("V'E/V'O2") || h.toUpperCase().includes("VE/VO2"));</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vevco2Idx = headerRow.findIndex(h =&gt; h.includes("V'E/V'CO2") || h.toUpperCase().includes("VE/VCO2"));</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vo2Idx = headerRow.findIndex((h, idx) =&gt; (h.includes("V'O2") || h.toUpperCase().includes("VO2")) &amp;&amp; idx !== vevo2Idx);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vco2Idx = headerRow.findIndex((h, idx) =&gt; (h.includes("V'CO2") || h.toUpperCase().includes("VCO2")) &amp;&amp; idx !== vevco2Idx);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let wrIdx = headerRow.findIndex(h =&gt; h.toUpperCase() === "WR");</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let rerIdx = headerRow.findIndex(h =&gt; h.toUpperCase() === "RER");</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let veIdx = headerRow.findIndex(h =&gt; h.includes("V'E") || h.toUpperCase() === "VE");</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let peto2Idx = headerRow.findIndex(h =&gt; h.toUpperCase().includes("PETO2"));</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let petco2Idx = headerRow.findIndex(h =&gt; h.toUpperCase().includes("PETCO2"));</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; if (vo2Idx === -1) vo2Idx = 0;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; if (wrIdx === -1) wrIdx = 4;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const results = [];</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; for (let i = 1; i &lt; lines.length; i++) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const line = lines[i].trim();</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (!line) continue;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; const cells = line.split(/\s+/);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (cells.length &lt;= vo2Idx || cells.length &lt;= wrIdx) continue;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (isNaN(parseFloat(cells[vo2Idx])) || isNaN(parseFloat(cells[wrIdx]))) continue;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let wrVal = parseFloat(cells[wrIdx]);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; // 🚀 核心新增：如果運動功率為 0W (靜止或熱身前原始列)，則直接過濾跳過</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (wrVal === 0) continue;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; results.push({</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vo2: parseFloat(cells[vo2Idx]),</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vco2: vco2Idx !== -1 &amp;&amp; vco2Idx &lt; cells.length ? parseFloat(cells[vco2Idx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; wr: wrVal,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vevo2: vevo2Idx !== -1 &amp;&amp; vevo2Idx &lt; cells.length ? parseFloat(cells[vevo2Idx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vevco2: vevco2Idx !== -1 &amp;&amp; vevco2Idx &lt; cells.length ? parseFloat(cells[vevco2Idx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; rer: rerIdx !== -1 &amp;&amp; rerIdx &lt; cells.length ? parseFloat(cells[rerIdx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; ve: veIdx !== -1 &amp;&amp; veIdx &lt; cells.length ? parseFloat(cells[veIdx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; peto2: peto2Idx !== -1 &amp;&amp; peto2Idx &lt; cells.length ? parseFloat(cells[peto2Idx]) : null,</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; petco2: petco2Idx !== -1 &amp;&amp; petco2Idx &lt; cells.length ? parseFloat(cells[petco2Idx]) : null</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; });</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; return results;</font></div><div><font color="#0f172a">&nbsp; &nbsp; }</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; // 🌟 核心閾值自動判讀決策引擎 🌟</font></div><div><font color="#0f172a">&nbsp; &nbsp; function autoDetectThresholds(data) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let detectedVT1 = 80;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let detectedVT2 = 130;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; lastDetectionLogs = [];</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; if (data.length &lt; 5) return { vt1: detectedVT1, vt2: detectedVT2 };</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // 讀取使用者自訂搜尋邊界與首選算法</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt1Min = parseFloat(document.getElementById('vt1-min-input').value) || 20;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt1Max = parseFloat(document.getElementById('vt1-max-input').value) || 200;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt2Min = parseFloat(document.getElementById('vt2-min-input').value) || 100;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt2Max = parseFloat(document.getElementById('vt2-max-input').value) || 240;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt1SelectedMethod = document.getElementById('vt1-method-select').value;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; const vt2SelectedMethod = document.getElementById('vt2-method-select').value;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // 二次多項式擬合最小平方法</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; function fitQuadraticCurve(filteredData, xKey, yKey) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let n = filteredData.length;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (n &lt; 5) return null;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let sumXRaw = 0;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; filteredData.forEach(d =&gt; sumXRaw += d[xKey]);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let xBase = sumXRaw / n;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let s1 = 0, s2 = 0, s3 = 0, s4 = 0;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let sy = 0, s1y = 0, s2y = 0;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; for (let i = 0; i &lt; n; i++) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let x = filteredData[i][xKey] - xBase;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let y = filteredData[i][yKey];</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (x === null || y === null || isNaN(x) || isNaN(y)) continue;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let x2 = x * x;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s1 += x;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s2 += x2;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s3 += x2 * x;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s4 += x2 * x2;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; sy += y;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s1y += x * y;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; s2y += x2 * y;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let det = s4 * (s2 * n - s1 * s1) - s3 * (s3 * n - s2 * s1) + s2 * (s3 * s1 - s2 * s2);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (Math.abs(det) &lt; 1e-6) return null;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let detA = s2y * (s2 * n - s1 * s1) - s3 * (s1y * n - sy * s1) + s2 * (s1y * s1 - sy * s2);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let detB = s4 * (s1y * n - sy * s1) - s2y * (s3 * n - s2 * s1) + s2 * (s3 * sy - s2 * s1y);</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let a = detA / det;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let b = detB / det;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return { a, b, xBase };</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // 滑動線性斜率工具</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; function getLocalRegressionSlope(arr, centerIdx, radius) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let start = Math.max(0, centerIdx - radius);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let end = Math.min(arr.length - 1, centerIdx + radius);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let n = end - start + 1;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (n &lt; 3) return 0;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let sumX = 0, sumY = 0, sumXY = 0, sumX2 = 0;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; for (let i = start; i &lt;= end; i++) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let x = arr[i].vo2;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let y = arr[i].vco2;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; sumX += x;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; sumY += y;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; sumXY += x * y;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let sX2 = x * x;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; sumX2 += sX2;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let denom = n * sumX2 - sumX * sumX;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (Math.abs(denom) &lt; 1e-6) return 0;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return (n * sumXY - sumX * sumY) / denom;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // ==========================================</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // 【VT1 判讀模組的分支控制】</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; // ==========================================</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vt1DataSubset = data.filter(d =&gt; d.wr &gt;= vt1Min &amp;&amp; d.wr &lt;= vt1Max);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; let vt1Identified = false;</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; function runVT1Regression() {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let vevo2Fit = fitQuadraticCurve(vt1DataSubset, 'wr', 'vevo2');</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (vevo2Fit &amp;&amp; vevo2Fit.a &gt; 0) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let vertex = -vevo2Fit.b / (2 * vevo2Fit.a) + vevo2Fit.xBase;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (vertex &gt;= vt1Min &amp;&amp; vertex &lt;= vt1Max) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; detectedVT1 = Math.round(vertex);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vt1Identified = true;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; lastDetectionLogs.push(`VT1 判讀成功：採用【VE/VO₂ 二次迴歸擬合】，成功定位二次拋物線最低點為 ${detectedVT1}W`);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return true;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; return false;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; }</font></div><div><font color="#0f172a"><br></font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; function runVT1AbsMin() {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; if (vt1DataSubset.length &gt; 0) {</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; let minObj = vt1DataSubset.reduce((min, p) =&gt; (p.vevo2 !== null &amp;&amp; p.vevo2 &lt; min.vevo2) ? p : min, vt1DataSubset[0]);</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; detectedVT1 = minObj.wr;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; vt1Identified = true;</font></div><div><font color="#0f172a">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; lastDetectionLogs.push(`VT1 判讀成功：採用【VE/VO₂ 絕對最低點法】，鎖定全域最小當量值於 ${detectedVT1}W`);</font></div><div><font color="#0f172